# Copie para .env e preencha. O .env NÃO é versionado.
#   cp .env.example .env

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=accesscontrolsystem
DB_PORT=5433

# --- Segredos do backend ---
# JWT_PRIVATE_KEY: chave de assinatura HMAC-SHA256. Gere uma aleatória:
#   openssl rand -base64 64
JWT_PRIVATE_KEY=
# PASSWORD_SALT_KEY: string aleatória qualquer.
PASSWORD_SALT_KEY=

# --- Portas expostas no host ---
BACKEND_PORT=5290
FRONTEND_PORT=5173

ASPNETCORE_ENVIRONMENT=Production
