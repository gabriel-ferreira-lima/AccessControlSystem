# AMBIENTE DE DESENVOLVIMENTO. Este compose e estes valores não servem para homologação nem produção.
# Copie para .env e preencha os segredos. O .env NÃO é versionado.
#   cp .env.example .env

# --- Postgres (superusuário: usado só pelos scripts de inicialização) ---
POSTGRES_PASSWORD=troque-por-uma-senha-forte
DB_PORT=5433

# --- Papéis do banco ---
# acs_migrator: dono dos bancos, aplica migrations (só o Migrator o usa).
# acs_app: usado pelas Apis; sem DDL, sem DELETE, sujeito ao RLS.
# Evite ; = e espaços nas senhas: elas entram em connection strings.
ACS_MIGRATOR_PASSWORD=dev-migrator-troque
ACS_APP_PASSWORD=dev-app-troque

# --- Segredos do backend ---
# JWT_PRIVATE_KEY: chave de assinatura HMAC-SHA256. Gere uma aleatória:
#   openssl rand -base64 64
JWT_PRIVATE_KEY=
# PASSWORD_SALT_KEY: sem uso no código (legado), mas o compose ainda a exige. String aleatória qualquer.
PASSWORD_SALT_KEY=

# --- Senhas dos operadores sintéticos de desenvolvimento (seed-dev) ---
# Mínimo 8 caracteres, com maiúscula, minúscula, número e símbolo. Valores de DESENVOLVIMENTO.
# admin@admin.com.br existe nos três tenants com DEV_ADMIN_PASSWORD; operador@exemplo.com existe
# nos tenants A e B com senhas diferentes.
DEV_ADMIN_PASSWORD=Admin!Dev2026
DEV_OPERATOR_PASSWORD_A=Operador!A2026
DEV_OPERATOR_PASSWORD_B=Operador!B2026

# --- Portas expostas no host ---
# backend = tenant A, backend-b = tenant B, backend-dedicated = tenant D (base dedicada)
BACKEND_PORT=5290
BACKEND_B_PORT=5291
BACKEND_DEDICATED_PORT=5292
FRONTEND_PORT=5173

ASPNETCORE_ENVIRONMENT=Development
